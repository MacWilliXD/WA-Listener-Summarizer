<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        style="@style/Widget.App.ButtonPrimary"
        android:id="@+id/buttonGrantPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Permisos de notificaciones"
        android:layout_marginBottom="12dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchWhatsApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recopilar notificaciones de WhatsApp"
        android:layout_marginBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchOthers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recopilar otras notificaciones"
        android:layout_marginBottom="8dp" />

    <Button
        style="@style/Widget.App.ButtonText"
        android:id="@+id/buttonViewDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Dashboard"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <Button
        style="@style/Widget.App.ButtonText"
        android:id="@+id/buttonTestConnectivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Probar conectividad OpenRouter"
        android:layout_marginTop="8dp" />

</LinearLayout>