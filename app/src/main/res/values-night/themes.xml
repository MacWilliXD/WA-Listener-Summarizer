<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NotiSummarizer" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Night: darker background with pastel green accents -->
        <item name="colorPrimary">@color/pastel_green_300</item>
        <item name="colorPrimaryVariant">@color/pastel_green_100</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/pastel_teal_300</item>
        <item name="colorSecondaryVariant">@color/pastel_mint</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/colorPrimaryVariant</item>
        <!-- Night: keep dark status icons for contrast -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#121212</item>
        <item name="colorBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="android:navigationBarColor">#121212</item>
    </style>
</resources>